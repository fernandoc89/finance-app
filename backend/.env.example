NODE_ENV=development

# Supabase: use Session pooler (IPv4). Copy host/user from Dashboard → Connect → Session pooler.
# Direct host db.<ref>.supabase.co is IPv6-only and fails on many Windows networks (ENOTFOUND).
DB_HOST=aws-1-us-east-2.pooler.supabase.com
DB_PORT=5432
DB_USERNAME=postgres.<your-project-ref>
DB_PASSWORD=your-database-password
DB_DATABASE=postgres

JWT_SECRET=change-me-in-production
PORT=3000

# Origens do front (Vercel, etc.), separadas por vírgula
CORS_ORIGINS=https://finance-app-nu-swart.vercel.app
